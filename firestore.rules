rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function validSnapshot(data) {
      return data.keys().hasOnly([
          'clientId', 'nickname', 'overall', 'dailyStreak', 'stars', 'clears', 'correct',
          'accuracy', 'streak', 'study', 'medals', 'dropCaseNormal', 'dropCaseEndless', 'updatedAt'
        ])
        && data.clientId is string
        && data.clientId.size() > 0
        && data.clientId.size() <= 64
        && data.nickname is string
        && data.nickname.size() > 0
        && data.nickname.size() <= 16
        && data.overall is number && data.overall >= 0
        && data.dailyStreak is number && data.dailyStreak >= 0 && data.dailyStreak <= 370
        && data.stars is number && data.stars >= 0 && data.stars <= 100
        && data.clears is number && data.clears >= 0 && data.clears <= 30
        && data.correct is number && data.correct >= 0
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
        && data.streak is number && data.streak >= 0
        && data.study is number && data.study >= 0 && data.study <= 30
        && data.medals is number && data.medals >= 0 && data.medals <= 100
        && data.dropCaseNormal is number && data.dropCaseNormal >= 0
        && data.dropCaseEndless is number && data.dropCaseEndless >= 0;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
      allow read: if roomMember(roomId);
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{userId} {
        allow read: if roomMember(roomId);
        allow create: if signedIn()
          && userId == request.auth.uid
          && validSnapshot(request.resource.data);
        allow update: if signedIn()
          && userId == request.auth.uid
          && validSnapshot(request.resource.data);
        allow delete: if signedIn()
          && (userId == request.auth.uid
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid);
      }
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.roomId is string;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /syncCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.syncId is string;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /syncProfiles/{syncId} {
      function linkedDevice() {
        return signedIn()
          && exists(/databases/$(database)/documents/syncProfiles/$(syncId)/devices/$(request.auth.uid));
      }
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId', 'payload', 'revision', 'updatedAt'])
        && request.resource.data.payload is map
        && request.resource.data.revision is int;
      allow read: if linkedDevice();
      allow update: if linkedDevice()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.keys().hasOnly(['ownerId', 'payload', 'revision', 'updatedAt'])
        && request.resource.data.payload is map
        && request.resource.data.revision is int;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /devices/{userId} {
        allow read: if linkedDevice();
        allow create: if signedIn() && userId == request.auth.uid
          && request.resource.data.code is string
          && getAfter(/databases/$(database)/documents/syncCodes/$(request.resource.data.code)).data.syncId == syncId;
        allow delete: if signedIn() && userId == request.auth.uid;
        allow update: if signedIn() && userId == request.auth.uid
          && request.resource.data.code == resource.data.code;
      }
    }
  }
}
