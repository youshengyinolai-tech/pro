rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function validSnapshot(data) {
      return data.keys().hasOnly([
          'nickname', 'overall', 'stars', 'clears', 'correct',
          'accuracy', 'streak', 'study', 'medals', 'updatedAt'
        ])
        && data.nickname is string
        && data.nickname.size() > 0
        && data.nickname.size() <= 16
        && data.overall is number && data.overall >= 0
        && data.stars is number && data.stars >= 0 && data.stars <= 39
        && data.clears is number && data.clears >= 0 && data.clears <= 13
        && data.correct is number && data.correct >= 0
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
        && data.streak is number && data.streak >= 0
        && data.study is number && data.study >= 0 && data.study <= 13
        && data.medals is number && data.medals >= 0 && data.medals <= 39;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
      allow read: if roomMember(roomId);
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{userId} {
        allow read: if roomMember(roomId);
        allow create: if signedIn()
          && userId == request.auth.uid
          && validSnapshot(request.resource.data);
        allow update: if signedIn()
          && userId == request.auth.uid
          && validSnapshot(request.resource.data);
        allow delete: if signedIn()
          && (userId == request.auth.uid
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid);
      }
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.roomId is string;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
