  "description": "コード事件捜査局 — 学習進捗ランキングルーム",
  "scripts": {
    "firebase:login": "XDG_CONFIG_HOME=.firebase-config firebase login",
    "firebase:use": "XDG_CONFIG_HOME=.firebase-config firebase use --add",
    "firebase:emulators": "XDG_CONFIG_HOME=.firebase-config firebase emulators:start",
    "firebase:deploy": "XDG_CONFIG_HOME=.firebase-config firebase deploy",
    "firebase:deploy:hosting": "XDG_CONFIG_HOME=.firebase-config firebase deploy --only hosting",
    "test": "node --test"
  },
